---
import Default from '../layouts/Default.astro';
---
<Default lang="es" title="David Beslanga – Frontend Developer">
  <!-- HERO -->
  <section id="hero" class="max-w-5xl mx-auto px-4 py-14">
    <div class="text-center space-y-3">
      <img src="/avatar.webp" alt="David Beslanga" width="104" height="104" class="mx-auto rounded-full" />
      <h1 class="text-4xl md:text-5xl font-extrabold">David Beslanga</h1>
      <p class="text-lg text-gray-600">Frontend Developer · React · UX · SEO</p>
      <div class="flex items-center justify-center gap-4 text-sm text-gray-600">
        <span>📍 Lima, Perú</span>
        <a href="mailto:tu@email.com" class="underline">email</a>
        <a href="https://github.com/tuusuario" class="underline">github</a>
        <a href="https://linkedin.com/in/tuusuario" class="underline">linkedin</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" data-spy="true" class="max-w-3xl mx-auto px-4 py-16 bg-white rounded-2xl shadow-sm">
    <h2 class="text-2xl font-semibold mb-3">Sobre mí</h2>
    <p class="leading-7 text-gray-700">
      Desarrollador Frontend con foco en UX, performance y SEO. Experiencia en React, Next, Vite, Tailwind...
    </p>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" data-spy="true" class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-semibold mb-6">Experiencia</h2>
    <!-- cards de experiencia -->
  </section>

  <!-- SKILLS -->
  <section id="skills" data-spy="true" class="max-w-5xl mx-auto px-4 py-16 bg-white rounded-2xl shadow-sm">
    <h2 class="text-2xl font-semibold mb-6">Skills</h2>
    <!-- chips de skills -->
  </section>

  <!-- PROJECTS -->
  <section id="projects" data-spy="true" class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-semibold mb-6">Proyectos</h2>
    <!-- grid de proyectos con imagen + enlaces -->
  </section>

  <!-- CONTACT -->
  <section id="contact" data-spy="true" class="max-w-3xl mx-auto px-4 py-16 bg-white rounded-2xl shadow-sm">
    <h2 class="text-2xl font-semibold mb-3">Contacto</h2>
    <p class="text-gray-700">Escríbeme a <a class="underline" href="mailto:tu@email.com">tu@email.com</a></p>
  </section>

  <footer class="py-10 text-center text-sm text-gray-500">© {new Date().getFullYear()} David Beslanga</footer>
</Default>
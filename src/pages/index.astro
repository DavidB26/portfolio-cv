---
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import ExperienceDetails from '../components/ExperienceDetails.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Skills from '../components/Skills.astro';
import Layout from '../layouts/Layout.astro';
import Contact from '../sections/Contact.astro';
---

<Layout
  lang="es"
  title="Desarrollador web freelance en Lima | David Beslanga"
  description="Desarrollo landing pages y sitios web rápidos, accesibles y orientados a conversión para empresas en Perú y Latinoamérica."
>
  <Hero />
  <Services />
  <Projects />
  <Experience />
  <ExperienceDetails />
  <About />
  <Skills />
  <Contact />
  <footer class="py-10 text-center text-sm text-gray-500">© {new Date().getFullYear()} David Beslanga</footer>
</Layout>

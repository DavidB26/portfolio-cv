---
import { Icon } from "astro-icon/components";

const skills = [
  { name: "HTML5", icon: "logos:html-5" },
  { name: "CSS / Sass", icon: "logos:sass" },
  { name: "JavaScript", icon: "logos:javascript" },
  { name: "TypeScript", icon: "logos:typescript-icon" },
  { name: "React.js", icon: "logos:react" },
  { name: "Next.js", icon: "logos:nextjs-icon" },
  { name: "Tailwind CSS", icon: "logos:tailwindcss-icon" },
  { name: "WordPress", icon: "logos:wordpress-icon" },
  { name: "Drupal", icon: "logos:drupal-icon" },
  { name: "Figma", icon: "logos:figma" },
  { name: "Git / GitHub", icon: "logos:github-icon" },
  { name: "Web Performance", icon: "mdi:speedometer" },
];
---

<section
  id="skills"
  data-spy="true"
  class="mx-auto mb-6 max-w-5xl rounded-2xl bg-white px-4 py-16 shadow-sm"
>
  <h2 class="mb-6 text-2xl font-semibold">Skills</h2>

  <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
    {skills.map((skill) => (
      <div
        class="flex flex-col items-center justify-between rounded-2xl bg-[#E8F0FB] p-6 text-center shadow-sm transition-all duration-300 hover:scale-[1.01] hover:shadow-md"
      >
        <div
          class="flex h-16 w-16 items-center justify-center rounded-xl border border-slate-200 bg-white"
        >
          <Icon name={skill.icon} class="h-10 w-10" />
        </div>
        <p class="mt-4 font-semibold text-slate-900">{skill.name}</p>
      </div>
    ))}
  </div>
</section>

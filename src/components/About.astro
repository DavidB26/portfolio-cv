---
const { lang = 'es' } = Astro.props;

const t = {
  title: lang === 'en' ? 'About me' : 'Sobre mí',
  body:
    lang === 'en'
      ? 'Front-end developer with 7+ years of experience building optimized, attractive and functional digital experiences. My approach combines intuitive design, high performance and efficient development, delivering interfaces that not only look great but also improve conversion and user experience.'
      : 'Desarrollador Web FrontEnd con más de 7 años de experiencia en la creación de experiencias digitales optimizadas, atractivas y funcionales. Mi enfoque combina diseño intuitivo, rendimiento optimizado y desarrollo eficiente, asegurando interfaces que no solo se ven bien, sino que también mejoran la conversión y la experiencia del usuario.',
};
---

<section id="about" data-spy="true" class="mx-auto mb-6 max-w-5xl rounded-2xl bg-white px-4 py-16 shadow-sm">
  <h2 class="text-2xl font-semibold mb-3">{t.title}</h2>
  <p class="leading-7 text-gray-700">
    {t.body}
  </p>
</section>

---
const { lang = 'es' } = Astro.props;
const t = {
  emailLabel: 'Email',
  emailPlaceholder: lang === 'en' ? 'your.email@example.com' : 'tu.email@ejemplo.com',
  messageLabel: lang === 'en' ? 'Message' : 'Mensaje',
  messagePlaceholder: lang === 'en' ? 'Tell me briefly how I can help you' : 'Cuéntame brevemente en qué puedo ayudarte',
  send: lang === 'en' ? 'Send' : 'Enviar',
};
---
<form
  class="space-y-6"
  method="POST"
  id="contact-form"
  data-contact
  novalidate
  action="/api/contact"
>
  <div
    id="contact-status"
    class="hidden px-4 py-3 text-sm border rounded-xl border-slate-200 bg-slate-50 text-slate-700"
    role="status"
    aria-live="polite"
  ></div>
  <div>
    <label for="email" class="block mb-1 text-sm font-medium text-slate-800">
      {t.emailLabel}
    </label>
    <input
      id="email"
      name="email"
      type="email"
      required
      placeholder={t.emailPlaceholder}
      class="w-full px-4 py-3 text-sm border rounded-lg shadow-sm border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
    />
  </div>
  <!-- Message -->
  <div>
    <label for="message" class="block mb-1 text-sm font-medium text-slate-800">
      {t.messageLabel}
    </label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"   
      placeholder={t.messagePlaceholder}
      class="w-full px-4 py-3 text-sm border rounded-lg shadow-sm resize-none border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
    ></textarea>
  </div>
  <div class="flex justify-end">
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-full bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
    >
      {t.send}
    </button>
  </div>
</form>
<script>
  // @ts-check
  /** @type {HTMLFormElement | null} */
  const form = document.getElementById('contact-form')

  /** @type {HTMLDivElement | null} */
  const statusEl = document.getElementById('contact-status')

  /**
   * @param {string} message
   * @param {'success' | 'error'} [type='success']
   */
  const showStatus = (message, type = 'success') => {
    if (!statusEl) return
    statusEl.classList.remove('hidden')

    // reset styles
    statusEl.classList.remove('border-green-200', 'bg-green-50', 'text-green-700')
    statusEl.classList.remove('border-red-200', 'bg-red-50', 'text-red-700')

    if (type === 'error') {
      statusEl.classList.add('border-red-200', 'bg-red-50', 'text-red-700')
    } else {
      statusEl.classList.add('border-green-200', 'bg-green-50', 'text-green-700')
    }

    statusEl.textContent = message
  }

  const hideStatus = () => {
    if (!statusEl) return
    statusEl.classList.add('hidden')
    statusEl.textContent = ''
  }

  /** @param {boolean} disabled */
  const disableSubmit = (disabled) => {
    const btn = form
      ? /** @type {HTMLButtonElement | null} */ (form.querySelector('button[type="submit"]'))
      : null

    if (!btn) return

    btn.disabled = disabled
    btn.classList.toggle('opacity-60', disabled)
    btn.classList.toggle('cursor-not-allowed', disabled)
  }

  /** @param {SubmitEvent} e */
  const handleSubmit = async (e) => {
    e.preventDefault()
    hideStatus()
    disableSubmit(true)

    try {
      /** @type {HTMLFormElement} */
      const formEl = /** @type {any} */ (e.target)
      const formData = new FormData(formEl)

      // Sending FormData (multipart/form-data) to the SSR API route.
      const endpoint = formEl.getAttribute('action') || '/api/contact'

      const res = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
        },
        body: formData,
      })

      if (!res.ok) {
        console.error('Contact action failed', res.status, res.statusText)
        let msgEs = 'No se pudo enviar el mensaje. Inténtalo nuevamente.'
        let msgEn = 'Could not send the message. Please try again.'

        try {
          const ct = res.headers.get('content-type') || ''
          if (ct.includes('application/json')) {
            const json = await res.json()
            if (json?.message) {
              msgEs = json.message
              msgEn = json.message
            }
          } else {
            const text = await res.text()
            if (text) {
              msgEs = text
              msgEn = text
            }
          }
        } catch {}

        const isEn = document.documentElement.lang === 'en'
        const msg = isEn ? msgEn : msgEs

        showStatus(msg, 'error')
        disableSubmit(false)
        return
      }

      formEl.reset()

      const isEn = document.documentElement.lang === 'en'
      showStatus(isEn ? 'Message sent ✅ I will reply soon.' : 'Mensaje enviado ✅ Te responderé pronto.', 'success')
    } catch {
      const isEn = document.documentElement.lang === 'en'
      showStatus(isEn ? 'Network error. Please try again.' : 'Error de red. Inténtalo nuevamente.', 'error')
    } finally {
      disableSubmit(false)
    }
  }

  if (form) form.addEventListener('submit', handleSubmit)
</script>
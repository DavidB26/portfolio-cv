---
import { Icon } from 'astro-icon/components';

const { lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';

const content = {
  title: isEnglish ? 'Selected work' : 'Proyectos seleccionados',
  intro: isEnglish
    ? 'Websites and digital experiences built for real business, content and conversion needs.'
    : 'Sitios y experiencias digitales desarrollados para necesidades reales de negocio, contenido y conversión.',
  cta: isEnglish ? 'View project' : 'Ver proyecto',
};

const projects = isEnglish
  ? [
      {
        category: 'Content / Security',
        title: 'Verisure Observatory',
        description: 'Informational platform focused on content hierarchy, navigation and a clear presentation of security reports and resources.',
        tags: ['WordPress', 'SEO', 'Content UX'],
        href: 'https://observatorioverisure.pe/',
        image: '/projects/observatorio.webp',
        imageAlt: 'Verisure Observatory website preview',
        width: 2880,
        height: 1354,
      },
      {
        category: 'Corporate B2B',
        title: 'ZAT — Corporate website',
        description: 'Structure, performance and user-experience improvements for a B2B website with clearer service and value messaging.',
        tags: ['B2B', 'Responsive', 'Performance'],
        href: 'https://zat.pe/',
        image: '/projects/zat.webp?v=1',
        imageAlt: 'ZAT corporate website preview',
        width: 2878,
        height: 1356,
      },
      {
        category: 'E-commerce',
        title: 'Andrea Skin — Store and catalog',
        description: 'Conversion-oriented store experience with simple navigation, a clear catalog and a responsive purchase flow.',
        tags: ['E-commerce', 'UX/UI', 'Responsive'],
        href: 'https://andreaskinsrl.com/',
        image: '/projects/andrea-skin.webp',
        imageAlt: 'Andrea Skin online store preview',
        width: 2878,
        height: 1356,
      },
      {
        category: 'Corporate / Pharma',
        title: 'Roxfarma — Corporate website',
        description: 'Corporate pharmaceutical website with clear navigation for products, certifications, services and company information.',
        tags: ['Information architecture', 'Corporate web', 'Responsive'],
        href: 'https://roxfarma.com/',
        image: '/projects/roxfarma.webp',
        imageAlt: 'Roxfarma corporate website preview',
        width: 2880,
        height: 1368,
      },
      {
        category: 'Personal project',
        title: 'CV presentation',
        description: 'Professional profile website with a downloadable résumé and sections optimized for fast reading, accessibility and responsive performance.',
        tags: ['Next.js', 'Tailwind CSS', 'TypeScript'],
        href: 'https://portfolio-sepia-theta-58.vercel.app/',
        image: '/projects/cv-portafolio.webp',
        imageAlt: 'CV portfolio website preview',
        width: 2880,
        height: 1356,
      },
    ]
  : [
      {
        category: 'Contenido / Seguridad',
        title: 'Observatorio Verisure',
        description: 'Plataforma informativa enfocada en jerarquía de contenido, navegación y presentación clara de reportes y recursos de seguridad.',
        tags: ['WordPress', 'SEO', 'UX de contenido'],
        href: 'https://observatorioverisure.pe/',
        image: '/projects/observatorio.webp',
        imageAlt: 'Vista previa del Observatorio Verisure',
        width: 2880,
        height: 1354,
      },
      {
        category: 'Corporativo B2B',
        title: 'ZAT — Sitio corporativo',
        description: 'Mejoras de estructura, rendimiento y experiencia para una web B2B con una comunicación más clara de servicios y propuesta de valor.',
        tags: ['B2B', 'Responsive', 'Performance'],
        href: 'https://zat.pe/',
        image: '/projects/zat.webp?v=1',
        imageAlt: 'Vista previa del sitio corporativo de ZAT',
        width: 2878,
        height: 1356,
      },
      {
        category: 'E-commerce',
        title: 'Andrea Skin — Tienda y catálogo',
        description: 'Experiencia orientada a conversión con navegación simple, catálogo claro y un flujo de compra adaptado a distintos dispositivos.',
        tags: ['E-commerce', 'UX/UI', 'Responsive'],
        href: 'https://andreaskinsrl.com/',
        image: '/projects/andrea-skin.webp',
        imageAlt: 'Vista previa de la tienda Andrea Skin',
        width: 2878,
        height: 1356,
      },
      {
        category: 'Corporativo / Pharma',
        title: 'Roxfarma — Web corporativa',
        description: 'Sitio farmacéutico con navegación clara para productos, certificaciones, servicios e información corporativa.',
        tags: ['Arquitectura de información', 'Web corporativa', 'Responsive'],
        href: 'https://roxfarma.com/',
        image: '/projects/roxfarma.webp',
        imageAlt: 'Vista previa del sitio corporativo de Roxfarma',
        width: 2880,
        height: 1368,
      },
      {
        category: 'Proyecto personal',
        title: 'Presentación de CV',
        description: 'Sitio de perfil profesional con CV descargable y secciones optimizadas para lectura rápida, accesibilidad y rendimiento responsive.',
        tags: ['Next.js', 'Tailwind CSS', 'TypeScript'],
        href: 'https://portfolio-sepia-theta-58.vercel.app/',
        image: '/projects/cv-portafolio.webp',
        imageAlt: 'Vista previa del portafolio de CV',
        width: 2880,
        height: 1356,
      },
    ];
---

<section id="projects" data-spy="true" class="mx-auto max-w-5xl px-4 py-16">
  <h2 class="text-2xl font-semibold">{content.title}</h2>
  <p class="mt-3 max-w-2xl text-slate-600">{content.intro}</p>

  <div class="mt-8 space-y-8">
    {projects.map((project, index) => (
      <article class={`flex flex-col items-center gap-8 rounded-2xl bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md ${index % 2 === 1 ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
        <div class="flex-1">
          <p class="text-sm font-semibold text-blue-700">{project.category}</p>
          <h3 class="mt-1 text-xl font-bold text-slate-950">{project.title}</h3>
          <p class="mt-3 leading-7 text-slate-700">{project.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{tag}</span>
            ))}
          </div>
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-blue-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-800"
          >
            {content.cta}
            <Icon name="mdi:arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <img
          src={project.image}
          alt={project.imageAlt}
          width={project.width}
          height={project.height}
          loading="lazy"
          decoding="async"
          class="aspect-[16/9] w-full rounded-2xl object-cover shadow-md ring-1 ring-black/10 md:w-1/2"
        />
      </article>
    ))}
  </div>
</section>

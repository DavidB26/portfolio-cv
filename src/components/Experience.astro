---
import { Icon } from 'astro-icon/components';

const { lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';

const t = {
  title: isEnglish ? 'Experience' : 'Experiencia',
  details: isEnglish ? 'See details' : 'Ver detalles',
  items: [
    {
      href: '#rol-verisure',
      logo: '/logos/logo-verisure.webp',
      logoAlt: 'Verisure',
      role: isEnglish ? 'Front-End Developer' : 'Programador Front-End',
      date: isEnglish ? 'May 2023 – Present' : 'Mayo 2023 – Actualidad',
      desc: isEnglish
        ? 'Landing page, blog and content-platform optimization focused on speed, accessibility and conversion.'
        : 'Optimización de landing pages, blog y plataformas de contenido con foco en velocidad, accesibilidad y conversión.',
      tags: ['Performance', 'CRO', 'WordPress', 'Drupal'],
      result: isEnglish ? 'Load time: ~7s → under 3s' : 'Carga: 7 s → menos de 3 s',
    },
    {
      href: '#rol-tottus',
      logo: '/logos/logo-tottus.webp',
      logoAlt: 'Tottus',
      role: isEnglish ? 'Front-End Developer' : 'Desarrollador Front-End',
      date: isEnglish ? 'September 2021 – January 2024' : 'Setiembre 2021 – Enero 2024',
      desc: isEnglish
        ? 'Modular promotional landing pages and dynamic content integrations for Tottus Chile.'
        : 'Landing pages modulares para campañas promocionales e integraciones de contenido dinámico para Tottus Chile.',
      tags: ['Landing pages', 'Contentful', 'ContentStack', 'UX/UI'],
    },
    {
      href: '#rol-centrum',
      logo: '/logos/logo-centrum.webp',
      logoAlt: 'Centrum PUCP',
      role: isEnglish ? 'Web Developer' : 'Programador Web',
      date: isEnglish ? 'April 2020 – September 2021' : 'Abril 2020 – Setiembre 2021',
      desc: isEnglish
        ? 'Custom landing pages, marketing automation and analytics integrations for lead acquisition.'
        : 'Landing pages personalizadas, automatización de marketing e integración de analítica para captación de leads.',
      tags: ['Eloqua', 'Analytics', 'Bootstrap', 'Responsive'],
    },
    {
      href: '#rol-electo',
      logo: '/logos/logo-electo.webp',
      logoAlt: 'Electo',
      role: isEnglish ? 'Web Developer' : 'Programador Web',
      date: isEnglish ? 'April 2018 – April 2020' : 'Abril 2018 – Abril 2020',
      desc: isEnglish
        ? 'Websites, blogs and cross-client compatible email marketing campaigns for multiple clients.'
        : 'Sitios web, blogs y campañas de email marketing compatibles con múltiples clientes de correo.',
      tags: ['HTML/CSS', 'WordPress', 'Laravel', 'Email marketing'],
    },
  ],
};
---

<section id="experience" data-spy="true" class="mx-auto max-w-5xl px-4 py-16">
  <h2 class="mb-6 text-2xl font-semibold">{t.title}</h2>

  <div class="space-y-6">
    {t.items.map((item) => (
      <a href={item.href} data-experience-link class="group block">
        <article class="flex flex-col items-start gap-5 rounded-2xl bg-white p-6 shadow-sm transition duration-200 group-hover:-translate-y-0.5 group-hover:shadow-md sm:flex-row">
          <img src={item.logo} alt={item.logoAlt} width="64" height="64" loading="lazy" class="h-16 w-16 rounded-lg object-contain" />
          <div class="min-w-0 flex-1">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              <h3 class="text-lg font-semibold text-slate-950">{item.role}</h3>
              <p class="shrink-0 text-sm text-slate-500">{item.date}</p>
            </div>
            <p class="mt-2 leading-7 text-slate-700">{item.desc}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{tag}</span>
              ))}
              {item.result && (
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">{item.result}</span>
              )}
            </div>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-blue-700">
              {t.details}
              <Icon name="mdi:chevron-down" class="h-4 w-4" />
            </span>
          </div>
        </article>
      </a>
    ))}
  </div>
</section>

---
import { Icon } from 'astro-icon/components';

const { lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';

const t = {
  tagline: isEnglish
    ? 'Front-End Web Developer · React · UX · SEO'
    : 'Desarrollador Web Front End · React · UX · SEO',
  value: isEnglish
    ? 'I build fast, accessible and conversion-focused landing pages and websites for businesses in Peru and Latin America.'
    : 'Desarrollo landing pages y sitios web rápidos, accesibles y orientados a conversión para empresas en Perú y Latinoamérica.',
  location: isEnglish ? 'Lima, Peru' : 'Lima, Perú',
  cta: isEnglish ? 'Tell me about your project' : 'Cuéntame tu proyecto',
  imageAlt: isEnglish
    ? 'David Beslanga, front-end web developer in Lima'
    : 'David Beslanga, desarrollador web front-end en Lima',
  linkedinLabel: isEnglish ? 'David Beslanga on LinkedIn' : 'LinkedIn de David Beslanga',
  githubLabel: isEnglish ? 'David Beslanga on GitHub' : 'GitHub de David Beslanga',
};
---

<section id="hero" class="mx-auto max-w-5xl px-4 py-14 md:py-16">
  <div class="space-y-3 text-center">
    <img
      src="/profile/yo.webp"
      alt={t.imageAlt}
      width="200"
      height="200"
      fetchpriority="high"
      class="mx-auto rounded-full"
    />
    <h1 class="text-4xl font-extrabold md:text-5xl">David Beslanga</h1>
    <p class="text-lg text-gray-600">{t.tagline}</p>
    <p class="mx-auto max-w-2xl pt-2 text-base leading-7 text-gray-600">{t.value}</p>

    <div class="flex flex-wrap items-center justify-center gap-4 pt-2 text-sm text-gray-600">
      <span class="flex items-center gap-1">
        <Icon name="mdi:map-marker" class="h-4 w-4" />
        {t.location}
      </span>
      <a href="mailto:contact@davidbeslanga.com" class="flex items-center gap-1 transition-colors hover:text-blue-700">
        <Icon name="mdi:email-outline" class="h-4 w-4" />
        contact@davidbeslanga.com
      </a>
      <a
        href="https://www.linkedin.com/in/david-beslanga/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.linkedinLabel}
        class="flex items-center gap-1 transition-colors hover:text-blue-700"
      >
        <Icon name="mdi:linkedin" class="h-4 w-4" />
        linkedin.com/in/david-beslanga/
      </a>
      <a
        href="https://github.com/DavidB26"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.githubLabel}
        class="flex items-center gap-1 transition-colors hover:text-blue-700"
      >
        <Icon name="mdi:github" class="h-4 w-4" />
        github.com/DavidB26
      </a>
    </div>

    <div class="pt-4">
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      >
        {t.cta}
        <Icon name="mdi:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
